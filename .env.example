# GUARDIAN_GROQ_API_KEY: Groq API Key for Guardian AI intelligence
GUARDIAN_GROQ_API_KEY=

# GROQ_API_KEY: Alternative environment variable name for Groq API
GROQ_API_KEY=

# GEMINI_API_KEY: Google Gemini API Key for Guardian AI Assistant
GEMINI_API_KEY=

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# Weather Telemetry API Key (Optional - includes automatic public fallback)
OPENWEATHER_API_KEY=

# Optional Firebase Staging Overrides (For separate Vercel preview environments)
# If omitted, default firebase-applet-config.json is used automatically.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Supabase Configuration (Guardian AI - Independent Supabase Edition)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
